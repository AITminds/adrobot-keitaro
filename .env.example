# demo работает без сети и ключей. Для реального трекера установите live.
ADROBOT_MODE=demo
DATABASE_URL=sqlite:///./adrobot.db
DEMO_DATABASE_URL=sqlite:///./demo-keitaro.db
CAMPAIGN_PREFIX=test_terentev_

# Только корень HTTPS-сервера, без /admin или /admin_api/v1.
KEITARO_BASE_URL=https://tracker.example.com
KEITARO_API_KEY=
KEITARO_TIMEOUT_SECONDS=15

# Для доступа вне localhost задайте логин/пароль и используйте HTTPS reverse proxy.
APP_USERNAME=
APP_PASSWORD=
